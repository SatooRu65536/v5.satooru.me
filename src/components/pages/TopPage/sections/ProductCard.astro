---
import dayjs from 'dayjs';
import CardLayout from '@/layouts/CardLayout.astro';
import { getEntryTerms, type ContentEntry } from 'emdash';
import { Image } from 'emdash/ui';
import penguinImg from '@/assets/penguin.webp';
import TechIcon from '@/components/icons/TechIcon.astro';
import { filterIconKeys } from '@/utils/icon';
import type { Post } from '../../../../../emdash-env';

interface Props {
  post: ContentEntry<Post>;
}

const { post } = Astro.props;

const formattedDate = dayjs(
  post.data.published_date ?? post.data.publishedAt,
).format('YYYY/MM/DD');
const href = `/post/${post.data.slug}`;

const [techTerms, typeTerms] = await Promise.all([
  getEntryTerms('posts', post.data.id, 'techs'),
  getEntryTerms('posts', post.data.id, 'types'),
]);

const techIconKeys = filterIconKeys(techTerms.map((term) => term.label));
const typeLabel = typeTerms[0]?.label;
---

<CardLayout class="card" href={href}>
  <div class="left">
    <h3 class="title">{post.data.title}</h3>
    {typeLabel && <h4 class="tag">{typeLabel}</h4>}
    <div class="techs">
      {techIconKeys.map((tech) => <TechIcon iconKey={tech} />)}
    </div>
    <p class="date">{formattedDate}</p>
  </div>

  <div class="right">
    <Image
      image={post.data.featured_image ?? penguinImg.src}
      class="thumbnail"
    />
  </div>
</CardLayout>

<style lang="scss">
  .card {
    overflow-x: scroll;
    display: flex;
    gap: 10px;
    background-color: $color-background-light;
    color: $color-text-light;

    & > div {
      min-width: 0;
    }

    .title {
      font-size: $font-size-base;
      text-wrap: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .left {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: $space-sm;

      .tag {
        font-size: $font-size-sm;
        font-weight: bold;
        color: $color-text-light;
      }

      .techs {
        display: flex;
        align-items: center;
        gap: 6px;
        overflow-x: scroll;
        min-width: 0;

        & > :global(svg) {
          flex-shrink: 0;
          width: $font-size-xl;
          height: $font-size-xl;
        }
      }

      .date {
        flex-shrink: 0;
        font-size: $font-size-sm;
      }
    }

    .right {
      flex-shrink: 0;
      width: 100px;
      height: 100px;
      border-radius: 5px;
      overflow: hidden;

      .thumbnail {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover;
      }
    }
  }
</style>
