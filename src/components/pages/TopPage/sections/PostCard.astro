---
import dayjs from 'dayjs';
import CardLayout from '@/layouts/CardLayout.astro';
import { extractPlainText, getEntryTerms, type ContentEntry } from 'emdash';
import { Image } from 'emdash/ui';
import penguinImg from '@/assets/penguin.webp';
import TechIcon from '@/components/icons/TechIcon.astro';
import { filterIconKeys } from '@/utils/icon';
import type { Post } from '../../../../../emdash-env';

interface Props {
  post: ContentEntry<Post>;
  showTechs?: boolean;
}

const { post, showTechs = false } = Astro.props;

const formattedDate = dayjs(
  post.data.published_date ?? post.data.publishedAt,
).format('YYYY/MM/DD');
const href = `/post/${post.data.slug}`;

const rawExcerpt = post.data.excerpt || extractPlainText(post.data.content);
const excerptText = rawExcerpt
  .replace(/<[^>]*>/g, '')
  .replace(/[#*_`>~\-]/g, '')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 200);

const techIconKeys = showTechs
  ? filterIconKeys(
      (await getEntryTerms('posts', post.data.id, 'techs')).map(
        (term) => term.label,
      ),
    )
  : [];
---

<CardLayout class="card" href={href}>
  <h3 class="title">{post.data.title}</h3>

  <div class="left">
    <div class="content">
      <p>{excerptText}</p>
      <div class="techs">
        {techIconKeys.map((tech) => <TechIcon iconKey={tech} />)}
      </div>
    </div>
    <div class="footer">
      <p class="date">{formattedDate}</p>
    </div>
  </div>

  <div class="right">
    <Image
      image={post.data.featured_image ?? penguinImg.src}
      class="thumbnail"
    />
  </div>
</CardLayout>

<style lang="scss">
  .card {
    overflow-x: scroll;
    display: grid;
    grid-template-rows: 1.5rem 1fr;
    grid-template-columns: 1fr 100px;
    gap: 10px;
    background-color: $color-background-light;
    color: $color-text-light;

    & > div {
      min-width: 0;
    }

    .title {
      grid-column: 1 / -1;
      font-size: $font-size-base;
      text-wrap: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .left {
      flex: 1;
      display: flex;
      flex-direction: column;

      .content {
        height: 80px;
        font-size: $font-size-sm;
        overflow: hidden;

        @include mobile {
          height: 75px;
        }
      }

      .techs {
        display: flex;
        align-items: center;
        gap: 6px;
        overflow-x: scroll;
        min-width: 0;

        & > :global(svg) {
          flex-shrink: 0;
          width: 16px;
          height: 16px;
        }
      }

      .footer {
        margin-top: auto;
        min-width: 0;
        text-align: end;

        .date {
          font-size: $font-size-sm;
        }
      }
    }

    .right {
      width: 100px;
      height: 100px;
      border-radius: 5px;
      overflow: hidden;

      .thumbnail {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover;
      }
    }
  }
</style>
