---
import PostCard from './PostCard.astro';
import SectionLayout from '@/layouts/SectionLayout.astro';
import {
  getEmDashCollection,
  getTermsForEntries,
  type TaxonomyTerm,
} from 'emdash';

interface Props {
  showTechs?: boolean;
}

const { showTechs = false } = Astro.props;

const { entries: posts, cacheHint } = await getEmDashCollection('posts', {
  orderBy: { published_date: 'desc', published_at: 'desc' },
  limit: 3,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const techsByEntry = showTechs
  ? await getTermsForEntries(
      'posts',
      posts.map((post) => post.data.id),
      'techs',
    )
  : new Map<string, TaxonomyTerm[]>();
---

<SectionLayout title="Recent Posts">
  <div class="recent-posts">
    {
      posts.map((post) => (
        <PostCard
          post={post}
          techIconKeys={(techsByEntry.get(post.data.id) ?? []).map(
            (term) => term.label,
          )}
        />
      ))
    }
  </div>
</SectionLayout>

<style lang="scss">
  .recent-posts {
    margin-inline: auto;
    max-width: 1200px;
    padding: 20px;
    display: grid;
    grid-template-columns: repeat(auto-fit, 300px);
    justify-content: center;
    gap: 20px;
  }
</style>
