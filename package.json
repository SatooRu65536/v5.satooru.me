{
  "name": "v5-satooru-me",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:cms": "pnpm --filter cms run dev",
    "dev:web": "pnpm --filter web run dev",
    "build:cms": "pnpm --filter cms run build",
    "build:web": "pnpm --filter web run build",
    "deploy:cms": "pnpm --filter cms run deploy",
    "deploy:web": "pnpm --filter web run deploy",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint --fix",
    "format": "prettier --write \"apps/*/src/**/*.astro\""
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.34.2",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.60.0"
  }
}
