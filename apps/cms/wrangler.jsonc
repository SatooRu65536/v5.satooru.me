{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cms-satooru-me",
	"account_id": "fa92a0ccd3de6f27140c99c7c6e0a8da",
	// Access を経由しない URL は公開しない
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "cms.satooru.me",
			"custom_domain": true
		}
	],
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"r2_buckets": [
		{
			"bucket_name": "v5-satooru-me",
			"binding": "MEDIA",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "v5-satooru-me",
			"database_id": "db7cc961-1e31-4e34-9a67-b7a0b34be20b",
			"remote": true
		}
	]
}