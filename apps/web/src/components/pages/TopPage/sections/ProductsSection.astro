---
import ProductCard from './ProductCard.astro';
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getTermsForEntries } from '@/lib/cms';
import { getPosts } from '@/lib/posts';

const posts = await getPosts();
const categoriesByEntry = await getTermsForEntries(
  'posts',
  posts.map((post) => post.id),
  'categories',
);
const products = posts.filter((post) =>
  categoriesByEntry.get(post.id)?.some((term) => term.slug === 'product'),
);
---

<SectionLayout title="Products">
  <div class="products">
    {products.map((product) => <ProductCard post={product} />)}
  </div>
</SectionLayout>

<style lang="scss">
  .products {
    margin-inline: auto;
    max-width: 1200px;
    padding: 20px;
    display: grid;
    grid-template-columns: repeat(auto-fit, 300px);
    justify-content: center;
    gap: 20px;
  }
</style>
