---
import PostCard from './PostCard.astro';
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getTermsForEntries } from '@/lib/cms';
import type { Term } from '@/lib/cms-types';
import { getPosts } from '@/lib/posts';

interface Props {
  showTechs?: boolean;
}

const { showTechs = false } = Astro.props;

const posts = (await getPosts()).slice(0, 3);

const techsByEntry = showTechs
  ? await getTermsForEntries(
      'posts',
      posts.map((post) => post.id),
      'techs',
    )
  : new Map<string, Term[]>();
---

<SectionLayout title="Recent Posts">
  <div class="recent-posts">
    {
      posts.map((post) => (
        <PostCard
          post={post}
          techIconKeys={(techsByEntry.get(post.id) ?? []).map(
            (term) => term.label,
          )}
        />
      ))
    }
  </div>
</SectionLayout>

<style lang="scss">
  .recent-posts {
    margin-inline: auto;
    max-width: 1200px;
    padding: 20px;
    display: grid;
    grid-template-columns: repeat(auto-fit, 300px);
    justify-content: center;
    gap: 20px;
  }
</style>
