---
import dayjs from 'dayjs';
import CardLayout from '@/layouts/CardLayout.astro';
import penguinImg from '@/assets/penguin.webp';
import TechIcon from '@/components/icons/TechIcon.astro';
import { filterIconKeys } from '@/utils/icon';
import type { Entry, Post } from '@/lib/cms-types';
import { extractPlainText, postDate, postThumbnail } from '@/lib/posts';

interface Props {
  post: Entry<Post>;
  techIconKeys?: string[];
}

const { post, techIconKeys = [] } = Astro.props;

const formattedDate = dayjs(postDate(post)).format('YYYY/MM/DD');
const href = `/post/${post.slug}`;
const thumbnail = postThumbnail(post);

const rawExcerpt = post.data.excerpt || extractPlainText(post.data.content);
const excerptText = rawExcerpt
  .replace(/<[^>]*>/g, '')
  .replace(/[#*_`>~\-]/g, '')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 200);

const filteredTechIconKeys = filterIconKeys(techIconKeys);
---

<CardLayout class="card" href={href}>
  <h3 class="title">{post.data.title}</h3>

  <div class="left">
    <div class="content">
      <p>{excerptText}</p>
      <div class="techs">
        {filteredTechIconKeys.map((tech) => <TechIcon iconKey={tech} />)}
      </div>
    </div>
    <div class="footer">
      <p class="date">{formattedDate}</p>
    </div>
  </div>

  <div class="right">
    <img
      src={thumbnail?.src ?? penguinImg.src}
      alt={thumbnail?.alt ?? ''}
      class="thumbnail"
      loading="lazy"
      decoding="async"
    />
  </div>
</CardLayout>

<style lang="scss">
  .card {
    overflow-x: scroll;
    display: grid;
    grid-template-rows: 1.5rem 1fr;
    grid-template-columns: 1fr 100px;
    gap: 10px;
    background-color: $color-background-light;
    color: $color-text-light;

    & > div {
      min-width: 0;
    }

    .title {
      grid-column: 1 / -1;
      font-size: $font-size-base;
      text-wrap: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .left {
      flex: 1;
      display: flex;
      flex-direction: column;

      .content {
        height: 80px;
        font-size: $font-size-sm;
        overflow: hidden;

        @include mobile {
          height: 75px;
        }
      }

      .techs {
        display: flex;
        align-items: center;
        gap: 6px;
        overflow-x: scroll;
        min-width: 0;

        & > :global(svg) {
          flex-shrink: 0;
          width: 16px;
          height: 16px;
        }
      }

      .footer {
        margin-top: auto;
        min-width: 0;
        text-align: end;

        .date {
          font-size: $font-size-sm;
        }
      }
    }

    .right {
      width: 100px;
      height: 100px;
      border-radius: 5px;
      overflow: hidden;

      .thumbnail {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover;
      }
    }
  }
</style>
